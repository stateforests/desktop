{
    "layer": "top",
    "position": "top",
    "height": 22,

    "modules-left": [
        "ext/workspaces",
        "wlr/taskbar"
    ],

    "modules-center": [
        "mpris"
    ],

    "modules-right": [
        "clock",
        "tray",
        "pulseaudio/slider"
    ],

    "ext/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}",
        "tooltip": false
    },

    "wlr/taskbar": {
        "format": "{app_id}",
        "on-click": "activate",
        "on-click-middle": "close",
        "rewrite": {
            "Alacritty": "alacritty",
            "org.prismlauncher.PrismLauncher": "prismlauncher",
            "org.wezfurlong.wezterm": "wezterm"
        },
        "tooltip": false
    },

    "mpris": {
        "format": "{status_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "status-icons": {
            "playing": "",
            "paused": "",
            "stopped": ""
        },
        "dynamic-order": ["artist", "title"],
        "dynamic-separator": " - ",
        "max-length": 60,
        "interval": 1,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "tooltip": false
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "clock": {
        "interval": 1,
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6,
        "show-passive-items": true,
        "tooltip": false
    }
}
